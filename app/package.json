{
  "name": "bili-listen-desktop",
  "productName": "BiliListen",
  "version": "1.1.2",
  "description": "BiliListen · 哔哩哔哩听视频桌面版",
  "main": "electron/main.js",
  "author": "耄耋",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node scripts/launch.js",
    "dev": "node scripts/launch.js --dev",
    "icon": "node scripts/make-icon.js",
    "pack": "electron-builder --dir --win",
    "dist": "node scripts/build.js"
  },
  "devDependencies": {
    "electron": "27.3.11",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "com.bililisten.desktop",
    "productName": "BiliListen",
    "copyright": "Copyright © 2026 耄耋",
    "directories": {
      "output": "../dist",
      "buildResources": "build"
    },
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "BiliListen-Setup-${version}.${ext}",
      "signingHashAlgorithms": [
        "sha256"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "BiliListen",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallDisplayName": "BiliListen ${version}"
    }
  }
}
